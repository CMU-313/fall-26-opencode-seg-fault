{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun --cwd packages/opencode test test/permission/annalin.property.test.ts --timeout 30000"
  },
  "coverageAnalysis": "off",
  "ignorePatterns": ["packages/console/**"],
  "inPlace": true,
  "concurrency": 1,
  "mutate": [
    "packages/opencode/src/permission/index.ts:28-38",
    "packages/opencode/src/permission/index.ts:67-169",
    "packages/opencode/src/permission/index.ts:186-198",
    "packages/core/src/util/wildcard.ts:3-14"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/annalin/mutation.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "timeoutMS": 30000
}
